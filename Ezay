-- Двигаем камеру назад уже после того, как игра её выставила.
-- Работает, если игра каждый кадр сама задаёт CFrame камеры.
local tpLast, tpBase = nil, nil
local function tpUndo(cam)
    if tpLast and cam.CFrame == tpLast then
        cam.CFrame = tpBase           -- игра не трогала камеру в этом кадре: откатываем наш сдвиг
    end
    tpLast, tpBase = nil, nil
end

local function updateThirdPerson(cam)
    if not S.Misc.ThirdPerson then return end
    local base = cam.CFrame
    local dist = S.Misc.TPDist
    local char = myChar()
    local ignore = { cam }
    if char then ignore[#ignore + 1] = char end
    rayParams.FilterDescendantsInstances = ignore
    local r = ownRay(base.Position, -base.LookVector * dist, rayParams)
    if r then dist = math.max(r.Distance - 0.6, 0.5) end   -- не пускаем камеру в стену
    local newCF = base * CFrame.new(1.2, 0.6, dist)
    cam.CFrame = newCF
    tpLast, tpBase = newCF, base
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
        end
    end
end

