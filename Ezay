local function playPreset(cfg, vol, customId)
    local snd = Instance.new("Sound")
    snd.Volume = vol
    snd.SoundId = customId or cfg.id
    snd.PlaybackSpeed = cfg.from
    for _, fx in ipairs(cfg.fx) do
        local ok, e = pcall(Instance.new, fx[1] .. "SoundEffect")
        if ok and e then
            for k, v in pairs(fx[2]) do
                pcall(function() e[k] = v end)
            end
            e.Parent = snd
        end
    end
    snd.Parent = SoundService
    snd:Play()
    if cfg.to ~= cfg.from then
        tween(snd, cfg.time, { PlaybackSpeed = cfg.to }, Enum.EasingStyle.Quad)
    end
    Debris:AddItem(snd, 4)
end

local function playShotSound()
    local name = S.Misc.ShotSound
    if name == "Off" then return end
    local now = os.clock()
    if now - lastSoundT < 0.03 then return end
    lastSoundT = now
    if name == "Custom" then
        local id = (tostring(S.Misc.CustomSoundId):gsub("%D", ""))
        if id == "" then return end
        playPreset({ from = 1, to = 1, time = 0.1, fx = {} }, S.Misc.SoundVol, "rbxassetid://" .. id)
    else
        local cfg = SoundPresets[name]
        if cfg then playPreset(cfg, S.Misc.SoundVol) end
    end
end

