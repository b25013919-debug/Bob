local charCache = {}

-- Ищем модель персонажа игрока (в Blox Strike она может лежать не в Player.Character)
local function resolveCharacter(plr)
    local c = plr.Character
    if c and c.Parent then return c end
    local now = os.clock()
    local cached = charCache[plr]
    if cached and now - cached.t < 1 then return cached.m end
    local found
    local direct = Workspace:FindFirstChild(plr.Name)
    if direct and direct:IsA("Model") then
        found = direct
    else
        for _, ch in ipairs(Workspace:GetChildren()) do
            if ch:IsA("Folder") or ch:IsA("Model") then
                local x = ch:FindFirstChild(plr.Name)
                if x and x:IsA("Model") then
                    found = x
                    break
                end
            end
        end
    end
    charCache[plr] = { m = found, t = now }
    return found
end

-- Свой персонаж (ищем так же, как персонажей других игроков)
local function myChar()
    return resolveCharacter(LocalPlayer)
end

local function getRoot(char)
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChildWhichIsA("BasePart")
end

local function getTorso(char)
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or getRoot(char)
end

local function getAimPart(char, mode)
    if mode == "Head" then
        return char:FindFirstChild("Head") or getRoot(char)
    elseif mode == "Torso" then
        return getTorso(char)
    end
    return getRoot(char)
end

local function getHealth(char)
    local h = char:FindFirstChildOfClass("Humanoid")
    if h then return h.Health, math.max(h.MaxHealth, 1) end
    local hp = char:GetAttribute("Health") or char:GetAttribute("health")
    if type(hp) == "number" then
        local mx = char:GetAttribute("MaxHealth") or 100
        return hp, math.max(mx, 1)
    end
    return 100, 100
end

local function isAlive(char)
    local hp = getHealth(char)
    return hp > 0
end

-- Враг ли игрок (учитываем и Team, и атрибуты, и FFA)
local function isEnemy(plr)
    if plr == LocalPlayer then return false end
    local myT, thT = LocalPlayer.Team, plr.Team
    if myT and thT then return myT ~= thT end
    local a, b = LocalPlayer:GetAttribute("Team"), plr:GetAttribute("Team")
    if a ~= nil and b ~= nil then return a ~= b end
    if not LocalPlayer.Neutral and not plr.Neutral then
        return LocalPlayer.TeamColor ~= plr.TeamColor
    end
    return true
end

local function passesTeam(plr, check)
    if plr == LocalPlayer then return false end
    if not check then return true end
    return isEnemy(plr)
end

-- Наш собственный рейкаст: вызов без двоеточия не попадает в __namecall-перехват
local function ownRay(origin, dir, params)
    return Workspace.Raycast(Workspace, origin, dir, params)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Видна ли часть без преград (прозрачные/неколлизионные детали пропускаем)
local function isVisible(part, char)
    local cam = getCamera()
    if not cam then return true end
    local ignore = { cam, char }
    local my = myChar()
    if my then ignore[#ignore + 1] = my end
    rayParams.FilterDescendantsInstances = ignore
    local origin = cam.CFrame.Position
    local dir = part.Position - origin
    for _ = 1, 4 do
        local r = ownRay(origin, dir, rayParams)
        if not r then return true end
        local hit = r.Instance
        if hit.CanCollide == false or hit.Transparency >= 0.95 then
            ignore[#ignore + 1] = hit
            rayParams.FilterDescendantsInstances = ignore
            origin = r.Position
            dir = part.Position - origin
        else
            return false
        end
    end
    return false
end

