-- ============================================================
-- ЦЕЛИ: игроки и (опционально) ЛЮБЫЕ модели с Humanoid
-- ============================================================
-- Если настоящие «тела» в игре — это не модели игроков (боты, отдельные хитбокс-модели),
-- режим «Все модели» увидит их и ESP, и аимбот.
local ModelSet = {}   -- [Model] = true: все модели, внутри которых есть Humanoid

local function considerInstance(d)
    if d:IsA("Humanoid") then
        local m = d.Parent
        if m and m:IsA("Model") then ModelSet[m] = true end
    end
end

local function startModelTracking()
    for _, d in ipairs(Workspace:GetDescendants()) do considerInstance(d) end
    track(Workspace.DescendantAdded:Connect(considerInstance))
    track(Workspace.DescendantRemoving:Connect(function(d)
        if d:IsA("Humanoid") then
            local m = d.Parent
            if m then ModelSet[m] = nil end
        elseif ModelSet[d] then
            ModelSet[d] = nil
        end
    end))
end

local function modelCount()
    local n = 0
    for _ in pairs(ModelSet) do n += 1 end
    return n
end

-- Проходит ли цель проверку «враг / не враг»
local function entPass(ent, check)
    if ent.plr then return passesTeam(ent.plr, check) end
    if not check then return true end
    local a = ent.char:GetAttribute("Team")
    local b = LocalPlayer:GetAttribute("Team") or (LocalPlayer.Team and LocalPlayer.Team.Name)
    if a ~= nil and b ~= nil then return tostring(a) ~= tostring(b) end
    return true
end

local entCache, entT, entMode = {}, 0, ""
local function getEntities(mode)
    local now = os.clock()
    if mode == entMode and now - entT < 0.03 then return entCache end
    local list, seen = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ch = resolveCharacter(plr)
            if ch then
                list[#list + 1] = {
                    plr = plr, char = ch, key = plr,
                    name = (plr.DisplayName ~= "" and plr.DisplayName) or plr.Name,
                }
                seen[ch] = true
            end
        end
    end
    if mode == "All" then
        local my = myChar()
        local cam = getCamera()
        for m in pairs(ModelSet) do
            if m.Parent and not seen[m] and m ~= my
                and not (my and m:IsDescendantOf(my)) and not (cam and m:IsDescendantOf(cam)) then
                if getRoot(m) then
                    list[#list + 1] = { plr = nil, char = m, key = m, name = m.Name .. " [модель]" }
                end
            end
        end
    end
    entCache, entT, entMode = list, now, mode
    return list
end

-- ---------- ESP (нативный: Highlight + BillboardGui + BoxHandleAdornment) ----------
-- Всё это рисует сам движок Roblox прямо на модели игрока, поэтому ESP не отстаёт от движения.
-- Только трассеры считаются вручную (по голове цели).
local function newESP(plr)
    local o = {}
    o.HL = new("Highlight", {
        FillTransparency = 0.55, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false, Parent = ESPFolder,
    })
    o.Box = new("BoxHandleAdornment", {
        AlwaysOnTop = true, ZIndex = 1, Transparency = 0.8, Visible = false, Parent = ESPFolder,
    })
    o.Tag = new("BillboardGui", {
        Size = UDim2.fromOffset(160, 46), AlwaysOnTop = true, LightInfluence = 0, Enabled = false, Parent = ESPFolder,
    })
    o.Name = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.35, Parent = o.Tag,
    })
    o.Info = new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 14),
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0.35, Parent = o.Tag,
    })
    o.HPBack = new("Frame", {
        Position = UDim2.new(0.1, 0, 0, 33), Size = UDim2.new(0.8, 0, 0, 4), BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = o.Tag,
    }, { corner(2) })
    o.HPFill = new("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = o.HPBack }, { corner(2) })
    o.Tracer = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false, Parent = Overlay,
    })
    o.sc, o.scT, o.lastInfo, o.lastName = 1, 0, "", ""
    ESPObjs[plr] = o
    return o
end

local function hideESP(o)
    o.HL.Enabled = false
    o.Box.Visible = false
    o.Tag.Enabled = false
    o.Tracer.Visible = false
end

local function destroyESP(plr)
    local o = ESPObjs[plr]
    if o then
        for _, v in pairs(o) do
            if typeof(v) == "Instance" then pcall(function() v:Destroy() end) end
        end
        ESPObjs[plr] = nil
    end
    local d = RadarDots[plr]
    if d then
        d:Destroy()
        RadarDots[plr] = nil
    end
    charCache[plr] = nil
end

local espWasOn = false
local function updateESP(cam, vp)
    local cfg = S.ESP
    if not cfg.Enabled then
        if espWasOn then
            espWasOn = false
            for _, o in pairs(ESPObjs) do hideESP(o) end
        end
        return
    end
    espWasOn = true
    local now = os.clock()
    local col = colorOf(cfg.Color)
    local camPos = cam.CFrame.Position
    local seenKeys = {}

    for _, ent in ipairs(getEntities(cfg.Targets)) do
        local key = ent.key
        seenKeys[key] = true
        local o = ESPObjs[key] or newESP(key)
        local char = ent.char
        local root = getRoot(char)
        local head = char:FindFirstChild("Head") or root
        local show = root and head and entPass(ent, cfg.TeamCheck) and isAlive(char)
        local dist = show and (root.Position - camPos).Magnitude or 0
        if show and dist > cfg.MaxDist then show = false end

        if not show then
            hideESP(o)
        else
            if now - o.scT > 1 then
                pcall(function() o.sc = math.clamp(char:GetExtentsSize().Y / 5.4, 0.6, 2) end)
                o.scT = now
            end
            local hp, mhp = getHealth(char)
            local frac = math.clamp(hp / mhp, 0, 1)

            -- Чамсы / контур
            local hlOn = cfg.Chams or cfg.Outline
            o.HL.Enabled = hlOn
            if hlOn then
                o.HL.Adornee = char
                o.HL.FillColor = col
                o.HL.OutlineColor = Color3.new(1, 1, 1)
                o.HL.FillTransparency = cfg.Chams and 0.55 or 1
            end

            -- 3D-бокс
            if cfg.Box then
                o.Box.Adornee = root
                o.Box.Size = Vector3.new(3.4 * o.sc, 5.8 * o.sc, 2.4 * o.sc)
                o.Box.Color3 = col
            end
            o.Box.Visible = cfg.Box

            -- Табличка: ник, HP, дистанция
            local tagOn = cfg.Name or cfg.Health or cfg.Distance
            o.Tag.Enabled = tagOn
            if tagOn then
                o.Tag.Adornee = head
                o.Tag.StudsOffsetWorldSpace = Vector3.new(0, 1.9 * o.sc, 0)
                o.Tag.MaxDistance = cfg.MaxDist
                o.Name.Visible = cfg.Name
                if cfg.Name then
                    if o.lastName ~= ent.name then
                        o.lastName = ent.name
                        o.Name.Text = ent.name
                    end
                    o.Name.TextColor3 = col
                end
                local parts = {}
                if cfg.Health then parts[#parts + 1] = math.floor(hp) .. " HP" end
                if cfg.Distance then parts[#parts + 1] = math.floor(dist) .. "m" end
                local txt = table.concat(parts, "  •  ")
                if txt ~= o.lastInfo then
                    o.lastInfo = txt
                    o.Info.Text = txt
                end
                o.HPBack.Visible = cfg.Health
                if cfg.Health then
                    o.HPFill.Size = UDim2.fromScale(frac, 1)
                    o.HPFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(70, 255, 120), frac)
                end
            end

            -- Трассер (экранный)
            local drawn = false
            if cfg.Tracers then
                local sp = cam:WorldToViewportPoint(root.Position)
                if sp.Z > 0 then
                    local from = Vector2.new(vp.X / 2, vp.Y)
                    local to = Vector2.new(sp.X, sp.Y)
                    local d = to - from
                    o.Tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
                    o.Tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
                    o.Tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
                    o.Tracer.BackgroundColor3 = col
                    drawn = true
                end
            end
            o.Tracer.Visible = drawn
        end
    end

    -- Убираем объекты тех, кого больше нет
    for key in pairs(ESPObjs) do
        if not seenKeys[key] then destroyESP(key) end
    end
end

-- ---------- Радар ----------
local function updateRadar(cam)
    Radar.Visible = S.Misc.Radar
    if not S.Misc.Radar then return end
    local R = Radar.AbsoluteSize.X / 2
    local range = math.max(S.Misc.RadarRange, 10)
    local seen = {}
    for _, ent in ipairs(getEntities(S.ESP.Targets)) do
        local key = ent.key
        seen[key] = true
        local dot = RadarDots[key]
        if not dot then
            dot = new("Frame", {
                Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5),
                BorderSizePixel = 0, Visible = false, Parent = Radar,
            }, { corner(4) })
            RadarDots[key] = dot
        end
        local root = getRoot(ent.char)
        if root and isAlive(ent.char) and entPass(ent, true) then
            local rel = cam.CFrame:PointToObjectSpace(root.Position)
            local v = Vector2.new(rel.X, rel.Z) / range
            if v.Magnitude > 1 then v = v.Unit end
            dot.Position = UDim2.fromOffset(R + v.X * (R - 5), R + v.Y * (R - 5))
            dot.BackgroundColor3 = colorOf(S.ESP.Color)
            dot.Visible = true
        else
            dot.Visible = false
        end
    end
    for key, dot in pairs(RadarDots) do
        if not seen[key] then
            dot:Destroy()
            RadarDots[key] = nil
        end
    end
end

