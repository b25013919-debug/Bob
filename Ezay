        local function setFromX(x)
            local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
            local v = min + (max - min) * a
            v = math.floor(v / step + 0.5) * step
            tbl[key] = math.clamp(v, min, max)
            update()
        end
        track(hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeDrag, activeObj, activePage = setFromX, input, page
                page.ScrollingEnabled = false
                setFromX(input.Position.X)
            end
        end))
    end

    local function Cycle(page, text, tbl, key, options, cb)
        local row = rowFrame(page)
        local lbl = rowText(row, text)
        lbl.Size = UDim2.new(1, -(Dev.cyc + 20), 1, 0)
        local btn = new("TextButton", {
            Size = UDim2.fromOffset(Dev.cyc, Dev.row - 12), AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0), BackgroundColor3 = Color3.fromRGB(42, 42, 62), BorderSizePixel = 0,
            Font = Enum.Font.GothamBold, TextSize = Dev.txt - 1, AutoButtonColor = true, Text = "", Parent = row,
        }, { corner(8) })
        accent(btn, "TextColor3")
        local function label()
            for _, o in ipairs(options) do
                if o[1] == tbl[key] then return o[2] end
            end
            return tostring(tbl[key])
        end
        btn.Text = label()
        track(btn.Activated:Connect(function()
            local idx = 1
            for i, o in ipairs(options) do
                if o[1] == tbl[key] then idx = i break end
            end
            idx = idx % #options + 1
            tbl[key] = options[idx][1]
            btn.Text = options[idx][2]
            if cb then pcall(cb, tbl[key]) end
            saveConfig()
        end))
    end

