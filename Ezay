local hpPrev = setmetatable({}, { __mode = "k" })
local hmUntil = 0
local HitOff = { { -8, -8 }, { 8, -8 }, { -8, 8 }, { 8, 8 } }
local function updateHitmarker(vp)
    local now = os.clock()
    if S.Misc.Hitmarker or S.Misc.HitSound ~= "Off" then
        for _, ent in ipairs(getEntities(S.Aim.Targets)) do
            local hp = getHealth(ent.char)
            local prev = hpPrev[ent.key]
            hpPrev[ent.key] = hp
            if prev and hp < prev and now - lastShotT < 0.6 and entPass(ent, true) then
                hmUntil = now + 0.28
                local cfg = HitPresets[S.Misc.HitSound]
                if cfg then pcall(playPreset, cfg, S.Misc.SoundVol) end
            end
        end
    end
    local left = hmUntil - now
    local show = S.Misc.Hitmarker and left > 0
    for i, f in ipairs(HitFrames) do
        f.Visible = show
        if show then
            f.Position = UDim2.fromOffset(vp.X / 2 + HitOff[i][1], vp.Y / 2 + HitOff[i][2])
            f.BackgroundTransparency = 1 - math.clamp(left / 0.28, 0, 1)
        end
    end
end

