-- ---------- Сканер моделей и отладка хитбоксов ----------
local dbgObjs, dbgParts, dbgT = {}, {}, 0

local function isPlayerModel(m)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == m or resolveCharacter(plr) == m then return plr end
    end
    return nil
end

local function clearDbgModels()
    for m, o in pairs(dbgObjs) do
        pcall(function() o.tag:Destroy() end)
        pcall(function() o.hl:Destroy() end)
        dbgObjs[m] = nil
    end
end

local function clearDbgParts()
    for p, a in pairs(dbgParts) do
        pcall(function() a:Destroy() end)
        dbgParts[p] = nil
    end
end

local function updateDebug(cam)
    local showModels, showBoxes = S.Misc.DbgModels, S.Misc.DbgHitbox
    if not showModels and next(dbgObjs) then clearDbgModels() end
    if not showBoxes and next(dbgParts) then clearDbgParts() end
    if not showModels and not showBoxes then return end
    local now = os.clock()

    -- Все модели с Humanoid: зелёные = модель игрока, жёлтые = НЕ игрок
    if showModels and now - dbgT > 0.5 then
        dbgT = now
        local my = myChar()
        local seen, n = {}, 0
        for m in pairs(ModelSet) do
            if m.Parent and m ~= my and n < 40 then
                local root = getRoot(m)
                if root then
                    n += 1
                    seen[m] = true
                    local o = dbgObjs[m]
                    if not o then
                        local tag = new("BillboardGui", {
                            Size = UDim2.fromOffset(190, 38), AlwaysOnTop = true, LightInfluence = 0,
                            StudsOffsetWorldSpace = Vector3.new(0, 4, 0), Adornee = root, Parent = ESPFolder,
                        })
                        local lbl = new("TextLabel", {
                            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold,
                            TextSize = 11, TextWrapped = true, TextStrokeTransparency = 0.3, Parent = tag,
                        })
                        local hl = new("Highlight", {
                            Adornee = m, FillTransparency = 0.85, OutlineTransparency = 0,
                            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = ESPFolder,
                        })
                        o = { tag = tag, lbl = lbl, hl = hl }
                        dbgObjs[m] = o
                    end
                    local owner = isPlayerModel(m)
                    local color = owner and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 220, 60)
                    o.tag.Adornee = root
                    o.lbl.TextColor3 = color
                    o.lbl.Text = m.Name .. "\n" .. (m.Parent and m.Parent.Name or "?")
                        .. (owner and (" [игрок " .. owner.Name .. "]") or " [НЕ игрок]")
                    o.hl.FillColor = color
                    o.hl.OutlineColor = color
                end
            end
        end
        for m, o in pairs(dbgObjs) do
            if not seen[m] then
                pcall(function() o.tag:Destroy() end)
                pcall(function() o.hl:Destroy() end)
                dbgObjs[m] = nil
            end
        end
    end

    -- Хитбоксы ближайшей к прицелу цели: красный = Head, голубой = видимая часть,
    -- жёлтый = НЕвидимая часть (скорее всего настоящий хитбокс)
    if showBoxes then
        local vp = cam.ViewportSize
        local center = Vector2.new(vp.X / 2, vp.Y / 2)
        local bestEnt, bestD = nil, math.huge
        for _, ent in ipairs(getEntities("All")) do
            local root = getRoot(ent.char)
            if root then
                local sp, on = cam:WorldToViewportPoint(root.Position)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestD then bestD, bestEnt = d, ent end
                end
            end
        end
        local want, n = {}, 0
        if bestEnt then
            for _, p in ipairs(bestEnt.char:GetDescendants()) do
                if p:IsA("BasePart") and n < 60 then
                    n += 1
                    want[p] = true
                end
            end
        end
        for p in pairs(want) do
            local a = dbgParts[p]
            if not a then
                a = new("BoxHandleAdornment", {
                    Adornee = p, AlwaysOnTop = true, ZIndex = 2, Transparency = 0.65, Size = p.Size, Parent = ESPFolder,
                })
                dbgParts[p] = a
            end
            a.Size = p.Size
            if p.Name == "Head" then
                a.Color3 = Color3.fromRGB(255, 60, 60)
            elseif p.Transparency >= 0.99 then
                a.Color3 = Color3.fromRGB(255, 210, 0)
            else
                a.Color3 = Color3.fromRGB(60, 200, 255)
            end
        end
        for p, a in pairs(dbgParts) do
            if not want[p] then
                pcall(function() a:Destroy() end)
                dbgParts[p] = nil
            end
        end
    end
end

-- Подробный отчёт по моделям: копируется в буфер обмена
local function collectModelReport()
    local L = {}
    local function add(s) L[#L + 1] = s end
    local my = myChar()
    local cam = getCamera()
    local camPos = cam and cam.CFrame.Position or Vector3.zero

    local list = {}
    for m in pairs(ModelSet) do
        if m.Parent then list[#list + 1] = m end
    end
    table.sort(list, function(a, b)
        local ra, rb = getRoot(a), getRoot(b)
        local da = ra and (ra.Position - camPos).Magnitude or 1e9
        local db = rb and (rb.Position - camPos).Magnitude or 1e9
        return da < db
    end)
    add("Claude v1.3 | модели с Humanoid: " .. #list)
    add("== Модели с Humanoid (ближайшие первыми) ==")
    for i, m in ipairs(list) do
        if i > 25 then
            add("...")
            break
        end
        local owner = isPlayerModel(m)
        local root = getRoot(m)
        local hum = m:FindFirstChildOfClass("Humanoid")
        local kids = {}
        for _, c in ipairs(m:GetChildren()) do kids[#kids + 1] = c.Name .. "(" .. c.ClassName .. ")" end
        add(string.format("[%d] %s | %s | hp=%s | dist=%s%s", i, pathOf(m),
            owner and ("игрок " .. owner.Name) or "НЕ ИГРОК",
            hum and tostring(math.floor(hum.Health)) or "?",
            root and tostring(math.floor((root.Position - camPos).Magnitude)) or "?",
            (m == my) and " | МОЙ" or ""))
        add("    дети: " .. join(kids, 14))
        local attrs = {}
        for k, v in pairs(m:GetAttributes()) do attrs[#attrs + 1] = tostring(k) .. "=" .. tostring(v) end
        if #attrs > 0 then add("    атрибуты: " .. join(attrs, 8)) end
    end

    add("== Игроки без найденной модели ==")
    local anyMissing = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not resolveCharacter(plr) then
            anyMissing = true
            add("  " .. plr.Name .. " (team=" .. tostring(plr.Team) .. ")")
        end
    end
    if not anyMissing then add("  таких нет") end

    add("== Модели рядом с игроками (возможные настоящие хитбоксы) ==")
    local found = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        local ch = (plr ~= LocalPlayer) and resolveCharacter(plr)
        local root = ch and getRoot(ch)
        if root then
            for _, d in ipairs(Workspace:GetDescendants()) do
                if found >= 20 then break end
                if d:IsA("Model") and d ~= ch and d ~= my
                    and not d:IsDescendantOf(ch) and not ch:IsDescendantOf(d) then
                    local r2 = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if r2 and (r2.Position - root.Position).Magnitude < 6 then
                        found += 1
                        add("  у " .. plr.Name .. ": " .. pathOf(d) .. " (" .. d.ClassName .. ")")
                    end
                end
            end
        end
    end
    if found == 0 then add("  не найдено") end
    return table.concat(L, "\n")
end

