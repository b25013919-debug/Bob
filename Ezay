local fpsAcc, fpsN, fpsShown, hudT = 0, 0, 60, 0
local function visStep(dt)
    if not Alive then return end
    local cam = getCamera()
    if not cam then return end
    local vp = cam.ViewportSize
    if not origFOV then origFOV = cam.FieldOfView end

    -- FOV камеры
    if S.Misc.FOVOn then
        cam.FieldOfView = S.Misc.FOV
        fovApplied = true
    elseif fovApplied then
        cam.FieldOfView = origFOV
        fovApplied = false
    end

    -- FOV-круг аимбота
    local showFov = S.Aim.Enabled and S.Aim.ShowFOV and S.Aim.Type ~= "Rage"
    FOVCircle.Visible = showFov
    if showFov then
        FOVCircle.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
        FOVCircle.Size = UDim2.fromOffset(S.Aim.FOV * 2, S.Aim.FOV * 2)
        FOVStroke.Color = Theme.Accent
    end

    updateThirdPerson(cam)
    updateHands(cam)
    updateAura()
    updateSkyFrame()
    updateHitmarker(vp)
    updateMute(cam)
    updateAimDot(cam)
    updateDebug(cam)
    updateESP(cam, vp)
    updateRadar(cam)
    updateCrosshair(vp)

    -- HUD
    HUDLabel.Visible = S.Misc.HUD
    if S.Misc.HUD then
        fpsAcc += dt
        fpsN += 1
        if fpsAcc >= 0.5 then
            fpsShown = math.floor(fpsN / fpsAcc + 0.5)
            fpsAcc, fpsN = 0, 0
        end
        hudT += dt
        if hudT > 0.5 then
            hudT = 0
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            HUDLabel.Text = "FPS " .. fpsShown .. "   •   Ping " .. ping .. " ms"
        end
    end
end

