-- Какие части тела рассматриваем
local function candidateParts(char)
    local list, seen = {}, {}
    local function add(p)
        if p and not seen[p] then
            seen[p] = true
            list[#list + 1] = p
        end
    end
    local pref = getAimPart(char, (S.Aim.Part == "Closest") and "Head" or S.Aim.Part)
    if S.Aim.Type == "Rage" then
        add(pref)                                   -- в рейдже: сначала выбранная часть, потом любая видимая
        add(char:FindFirstChild("Head"))
        add(getTorso(char))
        add(getRoot(char))
    elseif S.Aim.Part == "Closest" then
        add(char:FindFirstChild("Head"))
        add(getTorso(char))
        add(getRoot(char))
    else
        add(pref)
    end
    return list
end

-- Чем меньше значение — тем приоритетнее цель
local function scoreOf(cam, center, part, char)
    local pr = S.Aim.Priority
    if pr == "LowHP" then
        local hp = getHealth(char)
        return hp
    elseif pr == "Dist" then
        return (part.Position - cam.CFrame.Position).Magnitude
    end
    if S.Aim.Type == "Rage" then
        local dir = (part.Position - cam.CFrame.Position).Unit
        return math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir), -1, 1)))
    end
    local sp = cam:WorldToViewportPoint(part.Position)
    return (Vector2.new(sp.X, sp.Y) - center).Magnitude
end

local function validTarget(t, cam, center)
    if not t or not t.char or not t.char.Parent then return false end
    if not t.part or not t.part.Parent or not t.part:IsDescendantOf(t.char) then return false end
    if not isAlive(t.char) then return false end
    if not entPass(t.ent, S.Aim.TeamCheck) then return false end
    if (t.part.Position - cam.CFrame.Position).Magnitude > S.Aim.MaxDist then return false end
    if S.Aim.Type ~= "Rage" then
        local sp, on = cam:WorldToViewportPoint(t.part.Position)
        if not on or sp.Z <= 0 then return false end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > S.Aim.FOV * 1.25 then return false end
    end
    if S.Aim.WallCheck and not isVisible(t.part, t.char) then return false end
    return true
end

local function findTarget(cam, center)
    local best, bestScore = nil, math.huge
    local camPos = cam.CFrame.Position
    local rage = (S.Aim.Type == "Rage")
    for _, ent in ipairs(getEntities(S.Aim.Targets)) do
        local char = ent.char
        if entPass(ent, S.Aim.TeamCheck) and isAlive(char) then
            local pPart, pScore = nil, math.huge
            for _, part in ipairs(candidateParts(char)) do
                if (part.Position - camPos).Magnitude <= S.Aim.MaxDist then
                    local okFov = true
                    if not rage then
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        okFov = on and sp.Z > 0 and (Vector2.new(sp.X, sp.Y) - center).Magnitude <= S.Aim.FOV
                    end
                    if okFov and (not S.Aim.WallCheck or isVisible(part, char)) then
                        local sc = scoreOf(cam, center, part, char)
                        if sc < pScore then pPart, pScore = part, sc end
                        if rage then break end      -- в рейдже берём первую видимую часть по порядку
                    end
                end
            end
            if pPart and pScore < bestScore then
                best = { ent = ent, char = char, part = pPart }
                bestScore = pScore
            end
        end
    end
    return best
end

-- Скорость цели по истории позиций
local velTrack = setmetatable({}, { __mode = "k" })
local function measuredVelocity(part)
    local now = os.clock()
    local pos = part.Position
    local v = velTrack[part]
    if not v then
        velTrack[part] = { pos = pos, t = now, vel = Vector3.zero }
        return Vector3.zero
    end
    local dt = now - v.t
    if dt > 0.001 then
        v.vel = v.vel:Lerp((pos - v.pos) / dt, 0.35)
        v.pos, v.t = pos, now
    end
    return v.vel
end

-- Пинг (мс), обновляется раз в секунду
local pingCache, pingT = 0, 0
local function getPing()
    local now = os.clock()
    if now - pingT > 1 then
        pingT = now
        pcall(function() pingCache = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    end
    return pingCache
end

local function aimStep(dt)
    if not Alive then return end
    local cam = getCamera()
    if not cam then return end
    aimDotWorld = nil
    tpUndo(cam)                                   -- откат сдвига 3-го лица до расчётов
    if not S.Aim.Enabled then
        currentTarget = nil
        return
    end
    local active = (S.Aim.Mode == "Always") or aimKeyHeld or aimBtnHeld
    if not active then
        currentTarget = nil
        return
    end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local aimType = S.Aim.Type
    local rage = (aimType == "Rage")

    -- Липкая цель (в рейдже цель пересматривается каждый кадр)
    if not (S.Aim.Sticky and not rage and validTarget(currentTarget, cam, center)) then
        currentTarget = findTarget(cam, center)
    end
    local t = currentTarget
    if not t then return end

    local aimPos = t.part.Position + Vector3.new(0, S.Aim.YOffset, 0)
    local pm = S.Aim.PredictMode
    if pm ~= "Off" then
        -- скорость считаем сами по смещению цели (AssemblyLinearVelocity у чужих игроков часто врёт)
        local vel = measuredVelocity(t.part)
        local lead = (pm == "Auto") and (getPing() / 1000 + 0.03) or (S.Aim.Predict / 100)
        aimPos = aimPos + vel * lead
    end
    aimDotWorld = aimPos

    local alpha
    if rage then
        alpha = 1                                  -- мгновенный доворот
    elseif aimType == "Flick" then
        if os.clock() - lastFlick < S.Aim.FlickDelay / 1000 then return end
        lastFlick = os.clock()
        alpha = 1                                  -- одиночный резкий доворот раз в интервал
    else
        local base = 1 - math.clamp(S.Aim.Smooth, 0, 97) / 100
        alpha = 1 - (1 - base) ^ (math.clamp(dt, 0, 0.1) * 60)
        if S.Aim.Precise then
            -- когда прицел почти на цели — доводим точно, чтобы не мазать из-за плавности
            local sp, on = cam:WorldToViewportPoint(aimPos)
            if on and sp.Z > 0 and (Vector2.new(sp.X, sp.Y) - center).Magnitude < 22 then alpha = 1 end
        end
    end

    if S.Aim.Method == "Mouse" and Cap.mousemoverel then
        local sp = cam:WorldToViewportPoint(aimPos)
        pcall(mousemoverel, (sp.X - center.X) * alpha, (sp.Y - center.Y) * alpha)
    else
        local cf = cam.CFrame
        cam.CFrame = cf:Lerp(CFrame.new(cf.Position, aimPos), alpha)
    end

    -- Рейдж: авто-выстрел по захваченной цели
    if rage and S.Aim.RageFire and (os.clock() - lastRageShot) * 1000 >= S.Trigger.Delay then
        lastRageShot = os.clock()
        task.spawn(doClick)
    end
end

-- Триггербот: ищем цель под прицелом
local function crosshairEntity()
    local cam = getCamera()
    if not cam then return nil end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
    local ignore = { cam }
    if myChar() then ignore[#ignore + 1] = myChar() end
    rayParams.FilterDescendantsInstances = ignore
    local r = ownRay(ray.Origin, ray.Direction * 2000, rayParams)
    if not r then return nil end
    local inst = r.Instance
    while inst and inst ~= Workspace do
        local p = Players:FindFirstChild(inst.Name)
        if p and p:IsA("Player") and p ~= LocalPlayer then
            local ch = resolveCharacter(p)
            if ch then return { plr = p, char = ch, key = p } end
        end
        if S.Aim.Targets == "All" and ModelSet[inst] then
            return { plr = nil, char = inst, key = inst }
        end
        inst = inst.Parent
    end
    return nil
end

function doClick()
    lastShotT = os.clock()
    if not env.ClaudeHookInstalled or S.Misc.BTracers or S.Misc.ShotSound ~= "Off" then
        if not env.ClaudeHookInstalled then pcall(crosshairTracer) end
    end
    if Cap.mouse1click then
        pcall(mouse1click)
        return
    end
    if VIM then
        local cam = getCamera()
        if not cam then return end
        local vp = cam.ViewportSize
        pcall(function()
            VIM:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 0)
            task.wait(0.02)
            VIM:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 0)
        end)
    end
end

local lastShot = 0
local function startLoops()
    -- Триггербот
    task.spawn(function()
        while Alive do
            task.wait(0.01)
            if S.Trigger.Enabled then
                local ok, ent = pcall(crosshairEntity)
                if ok and ent and entPass(ent, true) then
                    if isAlive(ent.char) and (os.clock() - lastShot) * 1000 >= S.Trigger.Delay then
                        lastShot = os.clock()
                        doClick()
                    end
                end
            end
        end
    end)

    -- Свет
    task.spawn(function()
        local applied = false
        while Alive do
            local fb, nf = S.Misc.Fullbright, S.Misc.NoFog
            if fb or nf then
                applied = true
                pcall(function()
                    Lighting.Brightness = fb and 2 or origLight.Brightness
                    if S.Misc.Sky == "Off" then Lighting.ClockTime = fb and 14 or origLight.ClockTime end
                    Lighting.GlobalShadows = (not fb) and origLight.GlobalShadows
                    Lighting.Ambient = fb and Color3.fromRGB(178, 178, 178) or origLight.Ambient
                    Lighting.OutdoorAmbient = fb and Color3.fromRGB(178, 178, 178) or origLight.OutdoorAmbient
                    Lighting.FogEnd = nf and 9e9 or origLight.FogEnd
                    Lighting.FogStart = nf and 9e9 or origLight.FogStart
                end)
            elseif applied then
                applied = false
                restoreLight()
            end
            pcall(applySky)
            task.wait(0.4)
        end
    end)

    -- Привязки к рендеру (после камеры игры, чтобы она не перезаписала наш поворот)
    pcall(function() RunService:UnbindFromRenderStep("ClaudeAim") end)
    pcall(function() RunService:UnbindFromRenderStep("ClaudeVis") end)
    RunService:BindToRenderStep("ClaudeAim", Enum.RenderPriority.Last.Value, aimStep)
    RunService:BindToRenderStep("ClaudeVis", Enum.RenderPriority.Last.Value + 1, visStep)

    startExtras()
    track(Players.PlayerRemoving:Connect(destroyESP))
end

