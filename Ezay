local SkyPresets = {
    Sunset = { clock = 17.7, color = Color3.fromRGB(255, 160, 110), decay = Color3.fromRGB(255, 90, 70), haze = 2.2, glare = 0.6, density = 0.3, stars = 0, bodies = true, bloom = false },
    Night = { clock = 0, color = Color3.fromRGB(40, 55, 110), decay = Color3.fromRGB(10, 10, 35), haze = 1.6, glare = 0, density = 0.25, stars = 4000, bodies = true, bloom = false },
    Neon = { clock = 0, color = Color3.fromRGB(255, 80, 220), decay = Color3.fromRGB(90, 40, 255), haze = 3, glare = 1, density = 0.35, stars = 3000, bodies = false, bloom = true },
    Galaxy = { clock = 0, color = Color3.fromRGB(120, 80, 255), decay = Color3.fromRGB(20, 10, 60), haze = 2.5, glare = 0.4, density = 0.3, stars = 5000, bodies = false, bloom = true },
    Rainbow = { clock = 0, color = Color3.fromRGB(255, 80, 80), decay = Color3.fromRGB(80, 80, 255), haze = 3, glare = 0.8, density = 0.35, stars = 2500, bodies = false, bloom = true },
}
local skyOn, skyObj, skyAtm, skyAtmOwn, skyBloom, atmBackup = false, nil, nil, false, nil, nil
local skyHidden = {}

local function restoreSky()
    if not skyOn then return end
    skyOn = false
    if skyObj then pcall(function() skyObj:Destroy() end) skyObj = nil end
    if skyBloom then pcall(function() skyBloom:Destroy() end) skyBloom = nil end
    if skyAtm then
        if skyAtmOwn then
            pcall(function() skyAtm:Destroy() end)
        elseif atmBackup then
            pcall(function()
                skyAtm.Density, skyAtm.Offset, skyAtm.Color = atmBackup.Density, atmBackup.Offset, atmBackup.Color
                skyAtm.Decay, skyAtm.Glare, skyAtm.Haze = atmBackup.Decay, atmBackup.Glare, atmBackup.Haze
            end)
        end
    end
    skyAtm, skyAtmOwn, atmBackup = nil, false, nil
    for _, s in ipairs(skyHidden) do pcall(function() s.Parent = Lighting end) end
    skyHidden = {}
    pcall(function() Lighting.ClockTime = origLight.ClockTime end)
end

local function applySky()
    local name = S.Misc.Sky
    local p = SkyPresets[name]
    if not p then
        restoreSky()
        return
    end
    if not skyOn then
        skyOn = true
        for _, c in ipairs(Lighting:GetChildren()) do
            if c:IsA("Sky") and c.Name ~= "ClaudeSky" then skyHidden[#skyHidden + 1] = c end
        end
        for _, s in ipairs(skyHidden) do s.Parent = nil end
        skyObj = Instance.new("Sky")
        skyObj.Name = "ClaudeSky"
        -- пустые текстуры: небо рисуют только Atmosphere и звёзды
        for _, f in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
            skyObj[f] = ""
        end
        skyObj.Parent = Lighting
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            atmBackup = {
                Density = atm.Density, Offset = atm.Offset, Color = atm.Color,
                Decay = atm.Decay, Glare = atm.Glare, Haze = atm.Haze,
            }
            skyAtmOwn = false
        else
            atm = Instance.new("Atmosphere")
            atm.Parent = Lighting
            skyAtmOwn = true
        end
        skyAtm = atm
    end
    if skyObj and skyObj.Parent ~= Lighting then skyObj.Parent = Lighting end
    skyObj.StarCount = p.stars
    skyObj.CelestialBodiesShown = p.bodies
    skyAtm.Density = p.density
    skyAtm.Offset = 0.25
    skyAtm.Glare = p.glare
    skyAtm.Haze = p.haze
    if name ~= "Rainbow" then
        skyAtm.Color = p.color
        skyAtm.Decay = p.decay
    end
    Lighting.ClockTime = p.clock
    if p.bloom then
        if not skyBloom or not skyBloom.Parent then
            skyBloom = Instance.new("BloomEffect")
            skyBloom.Intensity = 0.7
            skyBloom.Size = 28
            skyBloom.Threshold = 1.1
            skyBloom.Parent = Lighting
        end
    elseif skyBloom then
        skyBloom:Destroy()
        skyBloom = nil
    end
end

local function updateSkyFrame()
    if skyOn and S.Misc.Sky == "Rainbow" and skyAtm and skyAtm.Parent then
        local h = (os.clock() * 0.08) % 1
        skyAtm.Color = Color3.fromHSV(h, 0.75, 1)
        skyAtm.Decay = Color3.fromHSV((h + 0.5) % 1, 0.85, 0.9)
    end
end

