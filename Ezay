local handOrig = setmetatable({}, { __mode = "k" })
local handParts, handScan = {}, 0
local MatMap = {
    Neon = Enum.Material.Neon, ForceField = Enum.Material.ForceField, Glass = Enum.Material.Glass,
}

local function restoreHands()
    for p, o in pairs(handOrig) do
        if p.Parent then
            pcall(function()
                p.Color = o.c
                p.Material = o.m
                p.Transparency = o.t
            end)
        end
        handOrig[p] = nil
    end
end

local function updateHands(cam)
    local mode = S.Misc.HandsMode
    local tp = S.Misc.ThirdPerson
    if mode == "Off" and not tp then
        if next(handOrig) then restoreHands() end
        return
    end
    local now = os.clock()
    if now - handScan > 0.4 then
        handScan = now
        handParts = {}
        for _, d in ipairs(cam:GetDescendants()) do
            if d:IsA("BasePart") then handParts[#handParts + 1] = d end
        end
    end
    local hue = (now * 0.25) % 1
    local mat = MatMap[S.Misc.HandsMat]
    for _, p in ipairs(handParts) do
        if p.Parent then
            local o = handOrig[p]
            if not o then
                o = { c = p.Color, m = p.Material, t = p.Transparency }
                handOrig[p] = o
            end
            if tp then
                p.Transparency = 1                      -- в 3 лице viewmodel прячем
            elseif mode == "Rainbow" then
                p.Color = Color3.fromHSV(hue, 1, 1)
                p.Material = mat or o.m
                p.Transparency = S.Misc.HandsTrans
            elseif mode == "Color" then
                p.Color = colorOf(S.Misc.HandsColor)
                p.Material = mat or o.m
                p.Transparency = S.Misc.HandsTrans
            else                                         -- Ghost: просто прозрачные
                p.Material = mat or o.m
                p.Transparency = S.Misc.HandsTrans
            end
        end
    end
end

