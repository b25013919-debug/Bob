        tracerHue = (tracerHue + 0.07) % 1
        col = Color3.fromHSV(tracerHue, 1, 1)
    else
        col = mine and Theme.Accent or Color3.fromRGB(255, 80, 80)
    end
    local life = S.Misc.BTracerTime
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = col
    p.Transparency = 0.15
    p.Size = Vector3.new(0.07, 0.07, len)
    p.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
    p.Parent = cam
    tween(p, life, { Transparency = 1 })
    Debris:AddItem(p, life + 0.2)
end

-- Вызывается из перехвата лучей, которые игра сама пускает для выстрелов
local function onGameRay(origin, direction, result)
    local wantTracer = S.Misc.BTracers
    local wantSound = S.Misc.ShotSound ~= "Off"
    local wantHit = S.Misc.Hitmarker or S.Misc.HitSound ~= "Off"
    if not (wantTracer or wantSound or wantHit) then return end
    if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then return end
    if direction.Magnitude < 60 then return end          -- короткие лучи (земля и т.п.) не трогаем
    local cam = getCamera()
    if not cam then return end
    local now = os.clock()
    local mine = (origin - cam.CFrame.Position).Magnitude < 12
    if not mine then
        local ch = myChar()
        local rp = ch and getRoot(ch)
        if rp and (origin - rp.Position).Magnitude < 12 then mine = true end
    end
    if mine then
        lastShotT = now
        if wantSound then pcall(playShotSound) end
    end
    if not wantTracer then return end
    if S.Misc.BTracerWho == "Mine" and not mine then return end
    if now - tracerWindow > 1 then tracerWindow, tracerCount = now, 0 end
    if tracerCount >= 60 then return end
    tracerCount += 1
    local target = (result and result.Position) or (origin + direction)
    local delta = target - origin
    if delta.Magnitude > 400 then target = origin + delta.Unit * 400 end
    local startPos = origin
    if mine then
        local cf = cam.CFrame
        startPos = origin + cf.RightVector * 0.6 - cf.UpVector * 0.5 + cf.LookVector * 1.2
    end
    drawTracer(startPos, target, mine)
end

-- Запасной вариант: свой выстрел по нажатию ЛКМ / нашему автовыстрелу
local function crosshairTracer()
    local cam = getCamera()
    if not cam then return end
    lastShotT = os.clock()
    pcall(playShotSound)
    if not S.Misc.BTracers then return end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
    local ignore = { cam }
    if myChar() then ignore[#ignore + 1] = myChar() end
    rayParams.FilterDescendantsInstances = ignore
    local r = ownRay(ray.Origin, ray.Direction * 500, rayParams)
    local target = r and r.Position or (ray.Origin + ray.Direction * 500)
    local cf = cam.CFrame
    local startPos = cf.Position + cf.RightVector * 0.6 - cf.UpVector * 0.5 + cf.LookVector * 1.2
    drawTracer(startPos, target, true)
end

local function installTracerHook()
    env.ClaudeOnRay = onGameRay        -- при повторном запуске просто подменяем обработчик
    if env.ClaudeHookInstalled then return end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then return end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if self == Workspace then
                local method = getnamecallmethod()
                local f = env.ClaudeOnRay
                if f and not (checkcaller and checkcaller()) then
                    if method == "Raycast" then
                        local origin, direction = ...
                        local result = old(self, ...)
                        pcall(f, origin, direction, result)
                        return result
                    elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
                        or method == "FindPartOnRayWithWhitelist" then
                        local ray = ...
                        local part, pos, nrm = old(self, ...)
                        if typeof(ray) == "Ray" then
                            pcall(f, ray.Origin, ray.Direction, { Position = pos })
                        end
                        return part, pos, nrm
                    end
                end
            end
            return old(self, ...)
        end)
    end)
    if ok then env.ClaudeHookInstalled = true end
end

-- ---------- Движение: баннихоп, скорость, полёт, noclip ----------
local origWalk, bhopKeyDown, noclipWas = nil, false, false

local function releaseBhopKey()
    if bhopKeyDown and VIM then
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
    end
    bhopKeyDown = false
end

local function restoreMovement()
    pcall(function()
        local ch = myChar()
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum and origWalk then hum.WalkSpeed = origWalk end
    end)
    origWalk = nil
    releaseBhopKey()
end

local function movementStep(dt)
    if not Alive then return end
    local char = myChar()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and getRoot(char)
    if not hum or not root or hum.Health <= 0 then return end
    local md = hum.MoveDirection
    local moving = md.Magnitude > 0.1
    local grounded = hum.FloorMaterial ~= Enum.Material.Air
    local cfg = S.Misc

    -- Скорость (WalkSpeed): запоминаем оригинал и возвращаем при выключении
    local wantWS = cfg.Speed and cfg.SpeedMode == "WalkSpeed" and not cfg.Fly
    if wantWS then
        if not origWalk then origWalk = hum.WalkSpeed end
        hum.WalkSpeed = cfg.SpeedValue
    elseif origWalk then
        hum.WalkSpeed = origWalk
        origWalk = nil
    end

    -- Скорость (CFrame / Velocity)
    if cfg.Speed and not cfg.Fly and moving then
        if cfg.SpeedMode == "CFrame" then
            root.CFrame = root.CFrame + md * math.max(cfg.SpeedValue - hum.WalkSpeed, 0) * dt
        elseif cfg.SpeedMode == "Velocity" then
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(md.X * cfg.SpeedValue, v.Y, md.Z * cfg.SpeedValue)
        end
    end

    -- Баннихоп
    if cfg.Bhop then
        local want
        if cfg.BhopMode == "Space" then
            want = UserInputService:IsKeyDown(Enum.KeyCode.Space)
        elseif cfg.BhopMode == "Constant" then
            want = true
        else
            want = moving
        end
        if want and grounded then
            if cfg.BhopJump == "Key" and VIM then
                pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game) end)
                bhopKeyDown = true
            else
                hum.Jump = true
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
        -- Ускорение в воздухе (скорость баннихопа)
        if want and cfg.BhopBoost and not grounded and moving and not cfg.Fly then
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(md.X * cfg.BhopSpeed, v.Y, md.Z * cfg.BhopSpeed)
        end
        if bhopKeyDown and (not grounded or not want) then releaseBhopKey() end
    elseif bhopKeyDown then
        releaseBhopKey()
    end

    -- Полёт: вперёд по взгляду камеры, Space / LeftCtrl — вверх / вниз
    if cfg.Fly then
        local cam = getCamera()
        local dir = Vector3.zero
        if moving then
            dir = md
            if cam then
                local look = cam.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude > 0.01 then
                    local fwd = md:Dot(flat.Unit)
                    dir = md + Vector3.new(0, look.Y * fwd, 0)
                end
            end
        end
        local up = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up += 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then up -= 1 end
        dir = dir + Vector3.new(0, up, 0)
        root.AssemblyLinearVelocity = dir * cfg.FlySpeed       -- без ввода: зависаем на месте
    end
end

local function fpsBoost()
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function() Lighting.GlobalShadows = false end)
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
            pcall(function() d.Enabled = false end)
        end
    end
    for _, e in ipairs(Lighting:GetChildren()) do
        if e:IsA("PostEffect") and e ~= skyBloom then
            pcall(function() e.Enabled = false end)
        end
    end
end

